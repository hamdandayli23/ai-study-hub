{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "AI Study Hub - Intelligent Study Workspace",
  "short_name": "AI Study Hub",
  "description": "Interactive AI Study Assistant: Summaries, Flashcards, AI Tutor, and Practice Quizzes.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#090d16",
  "theme_color": "#6366f1",
  "lang": "en",
  "categories": ["education", "productivity", "utilities"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Study Workspace",
      "short_name": "Workspace",
      "description": "Jump directly into your live study hub",
      "url": "./index.html#workspace",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Flashcards",
      "short_name": "Cards",
      "description": "Review and flip active recall cards",
      "url": "./index.html#flashcards",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Practice Quiz",
      "short_name": "Quiz",
      "description": "Test yourself with interactive quizzes",
      "url": "./index.html#quiz",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
